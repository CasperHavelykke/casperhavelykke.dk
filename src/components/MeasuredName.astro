---
interface Props {
  name: string;
  /** Tooltip explaining the number under the name. */
  label: string;
}

const { name, label } = Astro.props;
const words = name.split(' ');
---

<div class="measured">
  <h1 class="name" data-measured>
    {
      words.map((word, index) => (
        <>
          {index > 0 && ' '}
          <span>{word}</span>
        </>
      ))
    }
  </h1>
  <div class="dimension" aria-hidden="true" title={label}>
    <span class="dimension-line"></span>
    <span class="dimension-value" data-dimension-value></span>
  </div>
</div>

<script>
  const heading = document.querySelector<HTMLElement>('[data-measured]');
  const value = document.querySelector<HTMLElement>('[data-dimension-value]');

  if (heading && value) {
    const format = new Intl.NumberFormat(document.documentElement.lang);
    new ResizeObserver(() => {
      value.textContent = `${format.format(Math.round(heading.getBoundingClientRect().width))} px`;
    }).observe(heading);
  }
</script>

<style>
  /* Shrink-wraps to the longest word, so the dimension line spans exactly the name. */
  .measured {
    display: inline-block;
    max-width: 100%;
  }

  .name {
    font-size: clamp(3.25rem, 15.5vw, 10rem);
    font-weight: 800;
    line-height: 0.86;
    letter-spacing: -0.045em;
  }

  .name span {
    display: block;
  }

  .dimension {
    position: relative;
    height: 0.875rem;
    margin-top: 1.25rem;
    color: var(--accent);
  }

  .dimension-line {
    position: absolute;
    inset: 0;
    border-inline: 1.5px solid currentColor;
  }

  .dimension-line::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: 50%;
    border-top: 1.5px solid currentColor;
  }

  .dimension-value {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -52%;
    padding-inline: 0.625rem;
    background: var(--paper);
    font-size: var(--text-sm);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    white-space: nowrap;
  }

  .dimension-value:empty {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .dimension-line {
      animation: extend 700ms cubic-bezier(0.2, 0.7, 0.2, 1) 250ms both;
    }

    .dimension-value {
      animation: appear 300ms ease-out 850ms both;
    }
  }

  @keyframes extend {
    from {
      transform: scaleX(0);
    }
  }

  @keyframes appear {
    from {
      opacity: 0;
    }
  }
</style>

---
import Cover from './Cover.astro';
import { projectSlug, type Project } from '../lib/projects';
import { projectPath } from '../i18n/routes';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  project: Project;
  lang: Lang;
  /** Large rows on the front page, smaller ones in the full list. */
  size?: 'large' | 'small';
}

const { project, lang, size = 'large' } = Astro.props;
const t = useTranslations(lang);
const { title, summary, kind, year, tech, draft } = project.data;
const href = projectPath(lang, projectSlug(project));
const large = size === 'large';
---

<article class="grid grid-cols-1 gap-x-8 gap-y-5 md:grid-cols-12 md:items-center">
  <a
    href={href}
    tabindex="-1"
    aria-hidden="true"
    class:list={['block no-underline', large ? 'md:col-span-7' : 'md:col-span-4']}
  >
    <Cover
      project={project}
      sizes={large ? '(min-width: 48rem) 55vw, 100vw' : '(min-width: 48rem) 30vw, 100vw'}
    />
  </a>
  <div class:list={[large ? 'md:col-span-5' : 'md:col-span-8']}>
    <p class="text-sm text-muted">
      {t(`project.kind.${kind}` as const)}{year && `, ${year}`}
      {
        draft && (
          <span class="ml-2 rounded-full border border-current px-2 py-0.5">{t('project.draft')}</span>
        )
      }
    </p>
    <h3 class:list={['mt-2 font-bold', large ? 'text-xl md:text-2xl' : 'text-xl']}>
      <a href={href} class="text-ink-strong no-underline hover:underline">{title}</a>
    </h3>
    <p class="mt-3 max-w-[46ch]">{summary}</p>
    {tech.length > 0 && <p class="mt-3 text-sm text-muted">{tech.join(', ')}</p>}
  </div>
</article>

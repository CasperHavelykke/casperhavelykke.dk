---
import { Image } from 'astro:assets';
import type { Project } from '../lib/projects';

interface Props {
  project: Project;
  /** The `sizes` attribute for the responsive image. */
  sizes: string;
  /** Wide on the case page, 4:3 in lists. */
  wide?: boolean;
  eager?: boolean;
}

const { project, sizes, wide = false, eager = false } = Astro.props;
const { cover, coverAlt, title, year } = project.data;
const aspect = wide ? 'aspect-video' : 'aspect-[4/3]';
---

{
  cover ? (
    <Image
      src={cover}
      alt={coverAlt ?? ''}
      widths={[480, 800, 1200, 1600, 2400]}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      class:list={[aspect, 'w-full rounded-[4px] bg-glaze object-cover']}
    />
  ) : (
    <div class:list={[aspect, 'title-card']} aria-hidden="true">
      <span class="title-card-name">{title}</span>
      {year && <span class="title-card-year">{year}</span>}
    </div>
  )
}

<style>
  /* Projects without screenshots get their name set in type instead of a picture. */
  .title-card {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.5rem;
    padding: clamp(1.25rem, 4vw, 2.5rem);
    border: 1.5px solid var(--line);
    border-radius: 4px;
    background: var(--glaze);
  }

  .title-card-name {
    color: var(--ink-strong);
    font-size: clamp(2.25rem, 7vw, 4.5rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.04em;
    overflow-wrap: anywhere;
  }

  .title-card-year {
    color: var(--muted);
    font-size: var(--text-sm);
    font-weight: 600;
  }
</style>

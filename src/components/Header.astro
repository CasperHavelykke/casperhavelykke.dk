---
import { site } from '../config';
import { useTranslations, type Lang } from '../i18n/ui';
import { routes, type Alternates } from '../i18n/routes';

interface Props {
  lang: Lang;
  alternates: Alternates;
  isHome: boolean;
}

const { lang, alternates, isHome } = Astro.props;
const t = useTranslations(lang);
const otherLang: Lang = lang === 'da' ? 'en' : 'da';
const path = Astro.url.pathname;

const links = [
  { href: routes.projects[lang], label: t('nav.projects') },
  { href: routes.about[lang], label: t('nav.about') },
];
---

<header class="wrap flex flex-wrap items-baseline gap-x-8 gap-y-2 pt-6 pb-4">
  {
    !isHome && (
      <a href={routes.home[lang]} class="text-lg font-bold text-ink-strong no-underline">
        {site.name}
      </a>
    )
  }
  <nav aria-label={t('nav.label')} class="sm:ml-auto">
    <ul class="flex flex-wrap gap-x-6 gap-y-1">
      {
        links.map(({ href, label }) => (
          <li>
            <a
              href={href}
              aria-current={path.startsWith(href) ? 'page' : undefined}
              class="no-underline hover:underline aria-[current=page]:underline"
            >
              {label}
            </a>
          </li>
        ))
      }
      <li>
        <a href="#kontakt" class="no-underline hover:underline">{t('nav.contact')}</a>
      </li>
      <li>
        <a
          href={alternates[otherLang]}
          hreflang={otherLang}
          lang={otherLang}
          aria-label={t('lang.switchLabel')}
          class="text-muted no-underline hover:underline"
        >
          {t('lang.switch')}
        </a>
      </li>
    </ul>
  </nav>
</header>

---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

/**
 * An image with an optional caption inside a case study. Usable in every
 * project's MDX without an import; the image itself is imported in the MDX.
 */
interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** For tall phone screenshots that would be huge at full width. */
  narrow?: boolean;
}

const { src, alt, caption, narrow = false } = Astro.props;
---

<figure class:list={[narrow && 'max-w-[24rem]']}>
  <Image
    src={src}
    alt={alt}
    widths={narrow ? [384, 768] : [640, 960, 1280, 1920]}
    sizes={narrow ? '24rem' : '(min-width: 48rem) 40rem, 100vw'}
    class:list={['h-auto w-full rounded-[4px] bg-glaze', narrow && 'border-[1.5px] border-line']}
  />
  {caption && <figcaption class="mt-2 text-sm text-muted">{caption}</figcaption>}
</figure>

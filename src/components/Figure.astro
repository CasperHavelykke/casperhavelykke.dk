---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

/**
 * An image with an optional caption inside a case study. Usable in every
 * project's MDX without an import; the image itself is imported in the MDX.
 */
interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure>
  <Image
    src={src}
    alt={alt}
    widths={[640, 960, 1280, 1920]}
    sizes="(min-width: 48rem) 40rem, 100vw"
    class="h-auto w-full rounded-[4px] bg-glaze"
  />
  {caption && <figcaption class="mt-2 text-sm text-muted">{caption}</figcaption>}
</figure>

---
import type { GetStaticPaths } from 'astro';
import ProjectPage from '../../../views/ProjectPage.astro';
import { getProjects, projectSlug } from '../../../lib/projects';

export const getStaticPaths = (async () => {
  const projects = await getProjects('en');
  return projects.map((project) => ({ params: { slug: projectSlug(project) }, props: { project } }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
---

<ProjectPage lang="en" project={project} />

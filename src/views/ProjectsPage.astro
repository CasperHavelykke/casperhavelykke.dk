---
import Base from '../layouts/Base.astro';
import ProjectItem from '../components/ProjectItem.astro';
import { freelance } from '../data/freelance';
import { getProjects } from '../lib/projects';
import { routes } from '../i18n/routes';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const projects = await getProjects(lang);

const groups = [
  { id: 'kunder', title: t('projects.client'), items: projects.filter((p) => p.data.kind === 'client') },
  { id: 'egne', title: t('projects.personal'), items: projects.filter((p) => p.data.kind !== 'client') },
];
---

<Base
  lang={lang}
  title={t('projects.title')}
  description={t('projects.description')}
  alternates={routes.projects}
>
  <div class="wrap pt-10 md:pt-16">
    <h1 class="text-3xl font-bold md:text-4xl">{t('projects.title')}</h1>
    <p class="mt-5 max-w-[46ch] text-lg">{t('projects.intro')}</p>

    {
      groups.map((group) => (
        <section class="mt-20" aria-labelledby={group.id}>
          <h2 id={group.id} class="text-2xl font-bold">
            {group.title}
          </h2>
          {group.items.length > 0 ? (
            <ul class="mt-10 space-y-12">
              {group.items.map((project) => (
                <li>
                  <ProjectItem project={project} lang={lang} size="small" />
                </li>
              ))}
            </ul>
          ) : (
            <p class="mt-4 text-muted">{t('projects.empty')}</p>
          )}

          {group.id === 'kunder' && (
            <section class="mt-16" aria-labelledby="freelance">
              <h3 id="freelance" class="text-xl font-bold">
                {t('projects.freelance')}
              </h3>
              <p class="mt-2 max-w-[46ch] text-muted">{t('projects.freelanceIntro')}</p>
              <ul class="mt-6 border-t border-line">
                {freelance.map((job) => (
                  <li class="grid grid-cols-[1fr_auto] gap-x-6 border-b border-line py-3 sm:grid-cols-[13rem_1fr_auto]">
                    <span class="font-semibold text-ink-strong">
                      {job.url ? <a href={job.url}>{job.name}</a> : job.name}
                    </span>
                    <span class="text-sm text-muted tabular-nums sm:order-last sm:text-base">{job.year}</span>
                    <span class="col-span-2 text-muted sm:col-span-1">{job.work[lang]}</span>
                  </li>
                ))}
              </ul>
            </section>
          )}
        </section>
      ))
    }
  </div>
</Base>
